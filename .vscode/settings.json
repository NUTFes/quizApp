{
  // ============================================================
  // 全員のエディタで同じ動きをさせるための設定(リポジトリにコミットしてある)
  // 解説 → docs/CI・コードチェック入門.md §3【1】エディタ
  //
  // これが効いていると、保存した瞬間に自動整形されるので、
  // 書式のことを一切考えなくてよくなる。
  // ============================================================

  // 保存時に Prettier で自動整形する
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // 保存時に ESLint が自動で直せるものを直す
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // frontend/ 配下の設定ファイルを見つけられるようにする
  "eslint.workingDirectories": ["./frontend"],
  "prettier.configPath": "./frontend/.prettierrc",

  // Go は gofmt が標準搭載なので、保存時に整形する
  "[go]": {
    "editor.formatOnSave": true
  },

  // YAML は保存時に整形しない。
  // docker-compose.yml や ci.yml のコメントは読みやすさのために桁を揃えてあり、
  // Prettier にかけると全部1スペースに詰められて「1行直したいだけ」が全行差分になる。
  // CI の format:check は frontend/ の中でしか走らない(= ルートのYAMLは元々対象外)ので、
  // 整形しないほうが CI と手元の動きが一致する。
  "[yaml]": {
    "editor.formatOnSave": false
  },
  // docker-compose.yml は Docker拡張が "yaml" ではなく "dockercompose" という
  // 別の言語として扱うので、[yaml] だけでは効かない。両方書く必要がある。
  "[dockercompose]": {
    "editor.formatOnSave": false
  },

  // 改行コードを LF に統一(Windows と Mac/Linux の混在対策)
  "files.eol": "\n"
}
