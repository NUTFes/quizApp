# frontend の箱(本番用)の作り方。
#
# 開発は Vite の開発サーバーをそのまま動かすが、本番は違う:
#   ① Vite でビルドして、素の HTML/CSS/JS(= dist/)を作る
#   ② それを nginx に載せて配信する。Node はもう要らない
#
# nginx は同時に /api/ を backend へ中継するリバースプロキシも兼ねる。
# フロントとAPIを同一オリジンにすることで CORS 設定が一切不要になる。
# → dev_policy/インフラ・デプロイ_policy.md §前提と方針

# ---- ビルド用ステージ ----------------------------------------
FROM node:22 AS build
WORKDIR /app

RUN npm install -g pnpm@10

COPY package.json pnpm-lock.yaml* ./
RUN pnpm install --frozen-lockfile

COPY . .

# VITE_API_URL は意図的に渡さない。
# 未設定なら相対パスになる(src/lib/config.ts)ので、ビルド時に本番URLを知る必要がない。
#
# VITE_SURVEY_URL は逆に、ここで渡さないと本番に届かない。
# Vite の環境変数は「ビルドした瞬間の値」がJSに焼き込まれるので、
# compose の environment(= nginx が動く実行時)に書いても効かない。
# 渡し忘れても落ちないよう、未設定ならアンケート導線を出さない実装にしてある。
ARG VITE_SURVEY_URL
ENV VITE_SURVEY_URL=$VITE_SURVEY_URL

RUN pnpm build

# ---- 配信用ステージ ------------------------------------------
FROM nginx:1.27-alpine
RUN apk add --no-cache tzdata

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
