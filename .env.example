# バックエンド/フロントが読む環境変数の一覧(見取り図)。
# 開発の値は docker-compose.yml に直接書いてあるので、開発ではこのファイルを
# コピーして使う必要はない。「どんな変数があるか」を一覧するために置いている。
# 本番では実際の値を .env.prod に入れて注入する(→ dev_policy/インフラ・デプロイ_policy.md)。

# --- バックエンド ---
# DBの接続先(compose内では db という名前でDBコンテナに解決される)
DATABASE_URL=postgresql://quiz:quiz@db:5432/quiz?sslmode=disable

# 管理者APIのトークン。本番は長いランダム文字列にする(→ docs/API仕様書.md §0)
ADMIN_TOKEN=dev-admin-token
# 問題投入(GAS)用のトークン
IMPORT_TOKEN=dev-import-token

# スプレッドシート連携(開発では空でよい。同期機能だけ無効になる)
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_JSON=

# --- フロントエンド(Viteが読む。VITE_ で始まる変数だけがフロントに渡る) ---
VITE_API_URL=http://localhost:3000
VITE_USE_MOCK=false # バックエンドのSSEが完成するまではtrue

# アンケートGoogle FormのURL(finishedフェーズで表示)
VITE_SURVEY_URL=
