# 依存パッケージ(各自の環境で入れ直すのでコミットしない)
node_modules/

# ビルド成果物・一時ファイル
dist/
backend/tmp/
backend/server        

# 環境変数(秘密を含むのでコミットしない。.env.example だけ共有する)
.env
.env.prod
.env.local

# Google認証情報(絶対にコミットしない)
*credentials*.json

# OS が作るゴミファイル
.DS_Store
Thumbs.db

# 問題の画像。本番の画像はリポジトリに入れない(publicリポジトリのため)。
# 置き場所だけ .gitkeep で残し、中身は各環境に scp で置く。
backend/static/images/*
!backend/static/images/.gitkeep
