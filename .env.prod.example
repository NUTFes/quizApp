# 本番の設定値のひな形。
#
# ★ このファイルをコピーして .env.prod を作り、値を埋める。
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# ★ .env.prod は git に入れない(.gitignore 済み)。
#   トークンはイベント直前に発行し、終了後に無効化する使い捨て運用。
#   → dev_policy/インフラ・デプロイ_policy.md §トークンの扱い

# DBのパスワード。開発の quiz/quiz とは必ず変える。
# ★ base64 は使わない。/ や + が混ざると DATABASE_URL の区切りとして解釈され、
#   backend が DB に繋げずクラッシュループする(2026-08-25 に実際に踏んだ)。
# 生成例: openssl rand -hex 24
POSTGRES_PASSWORD=

# 管理者APIのトークン。長いランダム文字列にする。
# 生成例: openssl rand -hex 32
ADMIN_TOKEN=

# 問題投入(GAS)用のトークン。ADMIN_TOKEN とは別の値にする。
IMPORT_TOKEN=

# スプレッドシート連携。未使用なら空でよい(同期機能だけ無効になる)。
SPREADSHEET_ID=
GOOGLE_CREDENTIALS_JSON=

# モニタのQRコードが指す、参加者用のURL。末尾のスラッシュまで含める。
# 例: https://quiz.○○○.jp/
JOIN_URL=

# サーベイ用のURL
VITE_SURVEY_URL=

VITE_USE_MOCK=false
